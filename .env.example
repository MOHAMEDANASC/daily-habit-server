# Copy to .env and fill in real values. Never commit .env.
# Prisma CLI and Next.js both read .env from the project root.

# --- Database (PostgreSQL) -------------------------------------------------
# Local example: postgresql://USER:PASSWORD@localhost:5432/habit_tracker?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Application -----------------------------------------------------------
# Public base URL; used to build password-reset links.
APP_URL="http://localhost:3000"

# --- Email (password reset) ------------------------------------------------
# Leave SMTP_HOST empty in development: reset links are printed to the server log instead.
# In production SMTP is required, otherwise password-reset email cannot be delivered.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Habit Tracker <no-reply@example.com>"

# --- Scheduled reminders ----------------------------------------------------
# Shared secret that protects /api/cron/reminders (generate with `openssl rand -hex 32`).
# The route is disabled while this is empty.
CRON_SECRET=""

# --- Testing only -----------------------------------------------------------
# Never set in production: switches the DB-backed rate limiter off for automated tests.
RATE_LIMIT_DISABLED=""
# Separate database used by `npm run test:integration` (its tables are wiped between tests!).
TEST_DATABASE_URL=""
